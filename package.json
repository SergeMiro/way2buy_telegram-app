  "private": true,
  "description": "Way2Buy — Telegram Mini App loyalty & cashback system (demo)",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/db.js --reseed",
