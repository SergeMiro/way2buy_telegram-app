# ════════════════════════════════════════════════════════════════
#  Way2Buy Mini App — environment template. Copy to `.env`.
#  The demo runs with ZERO config (mock data + simulated Telegram).
#  Fill these in only when wiring the real bot + channels.
# ════════════════════════════════════════════════════════════════

PORT=4010

# ── Telegram bot (BotFather) ─────────────────────────────────────
# Token of the bot that hosts the Mini App and posts to the channels.
# The bot must be an ADMIN in both channels to post / read channel posts.
TELEGRAM_BOT_TOKEN=

# Channel usernames the app publishes to / watches (without @).
CHANNEL_UKRAINE=Way2Buy_Ukraine
CHANNEL_LUXURY=Way2Buy_Luxury

# Telegram user ids (comma-separated) allowed into the ADMIN panel
# (Maryna). Find yours via @userinfobot.
ADMIN_TG_IDS=

# Dasha and anyone else who must receive client inquiries as a DM but does not
# need the admin panel. Every inquiry goes to ADMIN_TG_IDS *and* these ids.
SUPPORT_TG_IDS=

# Public https URL of this app (needed for the Telegram webhook that
# watches channel posts). e.g. https://app.way2buy.example
PUBLIC_URL=

# ── Loyalty rule ─────────────────────────────────────────────────
# "Every $3000 spent → $100 back"
CASHBACK_STEP_USD=3000
CASHBACK_REWARD_USD=100

# ── AI reports (optional) ────────────────────────────────────────
# Gemini has a generous free tier — reports cost nothing to run.
# Leave empty to use the built-in template narrative (no AI call).
GEMINI_API_KEY=
