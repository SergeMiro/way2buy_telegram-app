# ════════════════════════════════════════════════════════════════
#  Way2Buy Mini App — environment template. Copy to `.env`.
#  With an empty file the app still runs: no DATABASE_URL means an
#  in-process Postgres (PGlite), and no bot token means simulated
#  Telegram. Fill these in to point at the real database and bot.
# ════════════════════════════════════════════════════════════════

PORT=4010

# ── Database ─────────────────────────────────────────────────────
# Postgres connection string (Supabase). Leave EMPTY to run against
# an in-memory PGlite instance — that is what the demo and the test
# suite use, and it needs no server.
#
# Which host to use:
#   • long-lived server (VPS, container) → the direct connection,
#     db.<ref>.supabase.co:5432. IPv6 only on the Free plan.
#   • serverless (Vercel) or an IPv4-only network → the Supavisor
#     pooler. Transaction mode (port 6543) for serverless, session
#     mode (5432) for a persistent process on IPv4.
# The app never names its prepared statements, so the transaction
# pooler works without further configuration.
#
# Prefer a dedicated least-privilege role over `postgres`: full DML
# on the data, no DDL, so the app cannot alter its own schema.
DATABASE_URL=

# Apply sql/schema.sql on boot. Off by default: 66 CREATE ... IF NOT
# EXISTS statements on every serverless cold start cost latency for
# nothing, and DDL from a request path is a bad habit. Use
# `npm run migrate` instead.
W2B_AUTO_MIGRATE=
# Insert the demo dataset on boot if the database is empty.
W2B_AUTO_SEED=
# Connection pool size. Defaults to 10, or 1 under Vercel (one
# concurrent request per function instance).
W2B_DB_POOL_MAX=

# ── Telegram bot (BotFather) ─────────────────────────────────────
# Token of the bot that hosts the Mini App and posts to the channels.
# The bot must be an ADMIN in every channel to post / read posts.
TELEGRAM_BOT_TOKEN=

# Channel usernames the app publishes to / watches (without @).
CHANNEL_UKRAINE=Way2Buy_Ukraine
CHANNEL_LUXURY=Way2Buy_Luxury

# The catalogues themselves are DATA, in the `channels` table — not settings.
# Add one with `npm run import:tme -- --channel @name` and it appears in the
# CATALOG tab on its own. Only two things about them live here:
#
# Which catalogue means "ready to ship". It is the one highlighted chip in the
# app, so it is keyed by name in case the channel is ever renamed.
IN_STOCK_CHANNEL_KEY=available
# Pause between page requests while importing a channel's history (ms). The
# default is deliberately unhurried — this is Telegram's public web page, and a
# backfill asks for it thousands of times.
W2B_TME_DELAY_MS=

# How many months of a channel the catalogue keeps. Default 6, and 0 keeps
# everything. This is a commercial setting: a bag posted a year ago is almost
# certainly sold, and a vitrine full of positions nobody can buy costs a client
# a message and an answer of "це вже продано". Widening it later also needs
#   update channels set history_done = false, sync_cursor = null;
# or a deepen pass has nothing to do.
W2B_CATALOG_MONTHS=6

# Telegram user ids (comma-separated) allowed into the ADMIN panel
# (Maryna). Find yours via @userinfobot.
ADMIN_TG_IDS=

# Dasha and anyone else who must receive client inquiries as a DM but does not
# need the admin panel. Every inquiry goes to ADMIN_TG_IDS *and* these ids.
SUPPORT_TG_IDS=

# Public https URL of this app (needed for the Telegram webhook that
# watches channel posts). e.g. https://app.way2buy.example
PUBLIC_URL=

# Long-poll instead of using a webhook — for local development, where
# there is no public URL to register.
W2B_TELEGRAM_POLLING=

# ── Loyalty rule ─────────────────────────────────────────────────
# Starting values only: both live in `discount_rules` and are edited
# from the admin panel, not from here.
CASHBACK_STEP_USD=3000
CASHBACK_REWARD_USD=100

# ── AI reports (optional) ────────────────────────────────────────
# Gemini has a generous free tier — reports cost nothing to run.
# Leave empty to use the built-in template narrative (no AI call).
GEMINI_API_KEY=
